SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=YOUR_CONNECTED_APP_CLIENT_ID
SF_AUTH_MODE=pkce
SF_REDIRECT_PORT=8788

# Optional
# SF_TOKEN_PATH=/absolute/path/to/.sf-auth.json
# SF_ALLOW_WRITE=1
# SF_ALLOW_METADATA=1

# Optional outreach personalization
# OUTREACH_SENDER_NAME=Troy Mott
# OUTREACH_SENDER_TITLE=VP of AI Operations
# OUTREACH_SENDER_COMPANY=Halosight
# OUTREACH_SENDER_FUNCTIONAL_ROLE=leading AI operations
# OUTREACH_SENDER_WORK_CONTEXT=customer intelligence and sales execution

# Optional Slack bot delivery
# SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN
# SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
# SLACK_CHANNEL_ID=C0123456789
# SLACK_MANUAL_REVIEW_LIMIT=0

# Optional LLM-assisted outreach drafting
# Default workflow remains template-based unless OUTREACH_DRAFT_MODE or --draft-mode is set.
# OUTREACH_DRAFT_MODE=template
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OUTREACH_LLM_MODEL=gpt-5-mini
# OUTREACH_LLM_REASONING_EFFORT=low
# OUTREACH_LLM_MAX_OUTPUT_TOKENS=900
# OUTREACH_LLM_TIMEOUT_MS=30000
# OUTREACH_LLM_FALLBACK=template
# OUTREACH_LLM_LOG_PATH=.outreach-generation-log.jsonl

# JWT mode only
# SF_USERNAME=admin@example.com
# SF_JWT_PRIVATE_KEY_PATH=/absolute/path/to/server.key
